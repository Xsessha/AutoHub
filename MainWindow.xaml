<Window x:Class="AutoHubPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoHub Pro | Автомобільний журнал"
        MinHeight="720" MinWidth="1080" Height="780" Width="1180"
        Background="#0B1120" Foreground="#E5E7EB"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111C30"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0B1527"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263650"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A4BC"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#0B1120"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#0B1120"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#111C30"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#147D9B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#17263D"/>
            <Setter Property="Foreground" Value="#A9BED8"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111C30" BorderBrush="#263650"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AUTOHUB  /  ГАРАЖНИЙ ЖУРНАЛ" Foreground="#38BDF8"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Контролюй витрати. Дбай про авто." FontSize="24"
                               FontWeight="Bold" Margin="0,5,0,3"/>
                    <TextBlock Text="Обслуговування, заправки та планування поїздок — в одному місці."
                               Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0B1527" CornerRadius="8"
                        Padding="12,8" VerticalAlignment="Center">
                    <TextBlock Text="АВТОМОБІЛЬНИЙ ЖУРНАЛ" Foreground="#A9BED8"
                               FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,18,0">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="#263650"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="НОВИЙ ЗАПИС" Foreground="#38BDF8"
                                   FontSize="12" FontWeight="Bold" Margin="0,0,0,14"/>

                        <TextBlock Text="Марка та модель авто" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCarModel" Text="Audi A6" MaxLength="80"/>

                        <TextBlock Text="Тип події" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,12,0,5"/>
                        <ComboBox x:Name="CmbCategory" SelectedIndex="0">
                            <ComboBoxItem Content="Заправка"/>
                            <ComboBoxItem Content="Техобслуговування"/>
                            <ComboBoxItem Content="Ремонт"/>
                            <ComboBoxItem Content="Інше"/>
                        </ComboBox>

                        <TextBlock Text="Дата події" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,12,0,5"/>
                        <DatePicker x:Name="DateRecord"/>

                        <TextBlock Text="Пробіг на момент події (км)" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,12,0,5"/>
                        <TextBox x:Name="TxtMileage" ToolTip="Ціле число, наприклад 185000"/>

                        <TextBlock Text="Наступне ТО, км (необов'язково)" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,12,0,5"/>
                        <TextBox x:Name="TxtNextServiceMileage"
                                 ToolTip="Вкажіть пробіг, на якому планується наступне ТО"/>

                        <TextBlock Text="Витрачено (грн)" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,12,0,5"/>
                        <TextBox x:Name="TxtAmount" ToolTip="Можна ввести десяткову кому або крапку"/>

                        <TextBlock Text="Витрата пального (л/100 км), необов'язково"
                                   Foreground="#A9BED8" FontSize="12" Margin="0,12,0,5"/>
                        <TextBox x:Name="TxtFuelConsumption"
                                 ToolTip="Заповніть для заправки; це значення підійде і для калькулятора"/>

                        <TextBlock Text="Опис" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,12,0,5"/>
                        <TextBox x:Name="TxtDescription" MinHeight="66"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" MaxLength="300"/>

                        <Button x:Name="BtnAddRecord" Content="＋  Додати до журналу" Click="BtnAddRecord_Click"
                                Margin="0,16,0,0" Background="#0E7490"/>

                        <Separator Margin="0,18,0,16" Background="#263650"/>

                        <TextBlock Text="КАЛЬКУЛЯТОР ПОЇЗДКИ" Foreground="#FBBF24"
                                   FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Відстань (км)" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtTripDistance" ToolTip="Довжина маршруту в кілометрах"/>
                        <TextBlock Text="Ціна пального (грн/л)" Foreground="#A9BED8"
                                   FontSize="12" Margin="0,12,0,5"/>
                        <TextBox x:Name="TxtFuelPrice" ToolTip="Ціна одного літра пального"/>
                        <Button Content="Розрахувати вартість" Click="BtnCalculateTrip_Click"
                                Margin="0,12,0,0" Background="#B7791F"/>
                        <TextBlock x:Name="LblTripResult" Text="Введіть відстань, витрату та ціну пального."
                                   Foreground="#FCD34D" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                        <Separator Margin="0,18,0,14" Background="#263650"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Імпорт JSON" Click="BtnImport_Click"
                                    Background="#263650" Margin="0,0,8,0"/>
                            <Button Content="Експорт JSON" Click="BtnExport_Click"
                                    Background="#263650"/>
                        </StackPanel>
                        <TextBlock Text="Автозбереження ввімкнено" Foreground="#6EE7B7"
                                   FontSize="11" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="175"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Історія автомобіля" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Історія робіт і витрат для вашого авто."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" x:Name="TxtSearch" VerticalAlignment="Center"
                             ToolTip="Пошук за авто, описом, пробігом або типом події"
                             TextChanged="TxtSearch_TextChanged"/>
                    <Button Grid.Column="2" Content="Видалити" Click="BtnDeleteRecord_Click"
                            Background="#9F3A43" Margin="10,0,0,0"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Подія:" Foreground="#A9BED8"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox x:Name="CmbCategoryFilter" Width="145" Height="32"
                                  SelectedIndex="0" SelectionChanged="Filters_Changed">
                            <ComboBoxItem Content="Усі події"/>
                            <ComboBoxItem Content="Заправка"/>
                            <ComboBoxItem Content="Техобслуговування"/>
                            <ComboBoxItem Content="Ремонт"/>
                            <ComboBoxItem Content="Інше"/>
                        </ComboBox>
                        <TextBlock Text="Сортувати:" Foreground="#A9BED8"
                                   FontSize="11" VerticalAlignment="Center" Margin="14,0,7,0"/>
                        <ComboBox x:Name="CmbSortOrder" Width="185" Height="32"
                                  SelectedIndex="0" SelectionChanged="Filters_Changed">
                            <ComboBoxItem Content="Нові спочатку"/>
                            <ComboBoxItem Content="Старі спочатку"/>
                            <ComboBoxItem Content="Пробіг: більший спочатку"/>
                            <ComboBoxItem Content="Витрати: більші спочатку"/>
                        </ComboBox>
                        <Button Content="Скинути фільтри" Click="BtnResetFilters_Click"
                                Background="#263650" Padding="9,6" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="GridRecords" AutoGenerateColumns="False"
                          Background="#111C30" RowBackground="#111C30"
                          AlternatingRowBackground="#142239" Foreground="#E5E7EB"
                          BorderBrush="#263650" BorderThickness="1"
                          HeadersVisibility="Column" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#22314A"
                          MouseDoubleClick="GridRecords_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"
                                            SortMemberPath="Date" Width="92"/>
                        <DataGridTextColumn Header="Авто" Binding="{Binding CarModel}"
                                            SortMemberPath="CarModel" Width="105"/>
                        <DataGridTextColumn Header="Подія" Binding="{Binding Category}"
                                            SortMemberPath="Category" Width="125"/>
                        <DataGridTextColumn Header="Пробіг, км" Binding="{Binding Mileage, StringFormat={}{0:N0}}"
                                            SortMemberPath="Mileage" Width="92"/>
                        <DataGridTextColumn Header="Опис" Binding="{Binding Description}"
                                            SortMemberPath="Description" Width="*"/>
                        <DataGridTextColumn Header="Витрати, грн" Binding="{Binding Amount, StringFormat={}{0:N2}}"
                                            SortMemberPath="Amount" Width="105"/>
                        <DataGridTextColumn Header="л/100 км" Binding="{Binding FuelConsumption, StringFormat={}{0:N1}}"
                                            SortMemberPath="FuelConsumption" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#111C30" BorderBrush="#263650"
                        BorderThickness="1" CornerRadius="10" Padding="14"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ВИТРАТИ ЗА ОСТАННІ 6 МІСЯЦІВ"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Сума витрат, грн"
                                       Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            <TextBlock x:Name="LblMaintenanceReminder" Grid.Column="2"
                                       Text="ТО: додайте план пробігу до запису"
                                       Foreground="#FBBF24" FontSize="10" FontWeight="SemiBold"
                                       Margin="16,0,0,0"
                                       ToolTip="Нагадування за поточним зафіксованим пробігом авто"/>
                        </Grid>
                        <ItemsControl x:Name="MonthlyChart" Grid.Row="1" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Height="105" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding AmountLabel}" Foreground="#A9BED8"
                                                       FontSize="10" HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       ToolTip="{Binding AmountTooltip}"/>
                                            <Border Width="28" Height="{Binding BarHeight}"
                                                    Background="#22B8CF" CornerRadius="4,4,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    ToolTip="{Binding AmountTooltip}"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding MonthLabel}"
                                                   Foreground="#93A4BC" FontSize="10"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#111C30" BorderBrush="#263650"
                        BorderThickness="1" CornerRadius="10" Padding="14"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ЗАПИСІВ У ЖУРНАЛІ" Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="LblTotalRecords" Text="0" FontSize="20"
                                       FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ВИТРАТИ ЦЬОГО МІСЯЦЯ" Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="LblMonthlyTotal" Text="0,00 грн"
                                       Foreground="#38BDF8" FontSize="20" FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="СЕРЕДНЯ ВИТРАТА" Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="LblAvgConsumption" Text="— л/100 км"
                                       Foreground="#6EE7B7" FontSize="20" FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
